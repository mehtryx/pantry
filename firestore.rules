rules_version = '2';

// Household model, strict:
//  - Only signed-in users from the allowed domain can access anything.
//  - All content docs (items, grocery, recipes, mealPlans) are keyed by
//    `householdId`, which equals the user's email domain.

service cloud.firestore {
  match /databases/{database}/documents {

    // >>> CONFIGURE ME: allowed email domain (also update .env for client) <<<
    function isDomainUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@benedicthome[.]com$');
    }

    function myHouseholdId() {
      return isDomainUser()
        ? request.auth.token.email.split('@')[1].lower()
        : '';
    }

    // Household documents
    match /households/{hid} {
      allow read, create, update: if isDomainUser();
    }

    // Content docs — only accessible to members of the matching household
    function contentReadAllowed(rsrc) {
      return isDomainUser() && rsrc.data.householdId == myHouseholdId();
    }
    function contentCreateAllowed() {
      return isDomainUser() && request.resource.data.householdId == myHouseholdId();
    }

    match /items/{doc} {
      allow read:   if contentReadAllowed(resource);
      allow create: if contentCreateAllowed();
      allow update, delete: if contentReadAllowed(resource);
    }

    match /grocery/{doc} {
      allow read:   if contentReadAllowed(resource);
      allow create: if contentCreateAllowed();
      allow update, delete: if contentReadAllowed(resource);
    }

    match /recipes/{doc} {
      allow read:   if contentReadAllowed(resource);
      allow create: if contentCreateAllowed();
      allow update, delete: if contentReadAllowed(resource);
    }

    match /mealPlans/{doc} {
      allow read:   if contentReadAllowed(resource);
      allow create: if contentCreateAllowed();
      allow update, delete: if contentReadAllowed(resource);
    }
  }
}
